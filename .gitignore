# ==============================================================================
# Security & Sensitive Files (Public Repository Protection)
# ==============================================================================
# Environment variables & configuration secrets
.env
.env.*
!.env.example
!.env.template

# Secret tokens, credentials, certificates, and private/public keys
*.pem
*.key
*.pkcs12
*.pfx
*.p12
*.crt
*.cer
*.der
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_ecdsa
id_ecdsa.pub
id_dsa
id_dsa.pub
*.secret
*.token
tokens.json
credentials.json
service_account*.json
client_secret*.json

# Cloud provider credentials
.aws/
.azure/
.gcloud/
.netrc

# ==============================================================================
# Oracle Database Specific Files
# ==============================================================================
# Oracle Wallets, keystores, and credentials
cwallet.sso
ewallet.p12
*.wallet
*.sso
*.jks
wallet_*.zip

# Oracle Trace, Dump, Alert & Log files
*.trc
*.trm
core_*
alert_*.log
*.dmp
*.dpdump
*.log
*.spool
*.spl
orapw*
pwd*.ora

# Local Oracle Network configuration overrides
tnsnames.ora.local
listener.ora.local
sqlnet.ora.local

# ==============================================================================
# VirtualBox & Virtualization Artifacts
# ==============================================================================
# VirtualBox VM settings & states
*.vbox
*.vbox-prev
*.vbox-tmp
*.sav
*.savedstate
*.nvram

# Virtual Disks (GBs of disk image data)
*.vdi
*.vmdk
*.vhd
*.vhdx
*.hdd
*.qcow2

# VM Export appliances & screen recordings
*.ova
*.ovf
*.webm

# VirtualBox logs & runtime directories
VBox.log*
VBoxHardening.log*
VirtualBox VMs/
.vagrant/
*.box

# ==============================================================================
